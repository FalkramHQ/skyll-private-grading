+package com.preeternal.scanner
+
+import android.content.Context
+import android.net.Uri
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+import java.io.FileOutputStream
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * Durable, cross-process store for document scanner results.
+ *
+ * ML Kit hands back `content://` URIs whose permission is tied to the current
+ * process. On low-RAM Android devices the OS can kill Skyll's React process
+ * while the external scanner activity is foregrounded, so those URIs (and the
+ * in-memory Promise that would have carried them to JS) are gone by the time
+ * the scan finishes. To survive that, the raw page bytes are copied into the
+ * app's private `filesDir` *inside the activity-result callback*, and a small
+ * JSON manifest keyed by a scan-session id is written next to them. A freshly
+ * started process can then ask for the result by id and still receive the pages.
+ *
+ * `filesDir` is deliberate: the OS never clears it the way it clears caches,
+ * which matters precisely under the memory pressure that triggers this bug.
+ */
+internal object PendingScanStore {
+  private const val ROOT_DIR = "scan-sessions"
+  private const val MANIFEST_FILE = "manifest.json"
+
+  // Guards concurrent read/write of the same session within one process.
+  private val lock = Any()
+
+  private fun rootDir(context: Context): File =
+    File(context.filesDir, ROOT_DIR).apply { if (!exists()) mkdirs() }
+
+  private fun sessionDir(context: Context, sessionId: String): File =
+    File(rootDir(context), sanitize(sessionId))
+
+  private fun sanitize(sessionId: String): String {
+    // Session ids are generated by JS, but never trust them as path segments.
+    val safe = sessionId.replace(Regex("[^A-Za-z0-9._-]"), "_")
+    return if (safe.isBlank()) "session" else safe
+  }
+
+  /**
+   * Copies every readable page into `filesDir` and writes the manifest.
+   * Returns the durable `file://` URIs, or an empty list when nothing could be
+   * persisted (in which case the caller still resolves the in-memory result).
+   */
+  fun persist(context: Context, sessionId: String, sourceUris: List<Uri>): List<String> {
+    if (sessionId.isBlank() || sourceUris.isEmpty()) return emptyList()
+    synchronized(lock) {
+      val dir = sessionDir(context, sessionId)
+      if (!dir.exists()) dir.mkdirs()
+      val durable = mutableListOf<String>()
+      sourceUris.forEachIndexed { index, uri ->
+        val target = File(dir, "page-$index.jpg")
+        try {
+          context.contentResolver.openInputStream(uri)?.use { input ->
+            FileOutputStream(target).use { output -> input.copyTo(output) }
+          } ?: return@forEachIndexed
+          if (target.length() > 0) durable.add(Uri.fromFile(target).toString())
+        } catch (_: Exception) {
+          // Skip unreadable page; valid pages are still recoverable.
+          target.delete()
+        }
+      }
+      if (durable.isEmpty()) {
+        dir.deleteRecursively()
+        return emptyList()
+      }
+      val manifest = JSONObject().apply {
+        put("sessionId", sessionId)
+        put("createdAt", System.currentTimeMillis())
+        put("pages", JSONArray(durable))
+      }
+      File(dir, MANIFEST_FILE).writeText(manifest.toString())
+      return durable
+    }
+  }
+
+  /** Returns the persisted page URIs for [sessionId], or null if none exist. */
+  fun read(context: Context, sessionId: String): List<String>? {
+    if (sessionId.isBlank()) return null
+    synchronized(lock) {
+      val manifestFile = File(sessionDir(context, sessionId), MANIFEST_FILE)
+      if (!manifestFile.exists()) return null
+      return try {
+        val json = JSONObject(manifestFile.readText())
+        val array = json.optJSONArray("pages") ?: return null
+        val pages = mutableListOf<String>()
+        for (index in 0 until array.length()) {
+          val page = array.optString(index, "")
+          if (page.isNotBlank() && File(Uri.parse(page).path ?: "").exists()) pages.add(page)
+        }
+        if (pages.isEmpty()) null else pages
+      } catch (_: Exception) {
+        null
+      }
+    }
+  }
+
+  fun discard(context: Context, sessionId: String) {
+    if (sessionId.isBlank()) return
+    synchronized(lock) {
+      sessionDir(context, sessionId).deleteRecursively()
+    }
+  }
+
+  /**
+   * Deletes session directories older than [maxAgeMs]. Called opportunistically
+   * on each persist so an abandoned scan's files cannot accumulate forever.
+   */
+  fun pruneExpired(context: Context, maxAgeMs: Long) {
+    synchronized(lock) {
+      val root = rootDir(context)
+      val cutoff = System.currentTimeMillis() - maxAgeMs
+      root.listFiles()?.forEach { dir ->
+        val manifest = File(dir, MANIFEST_FILE)
+        val createdAt = if (manifest.exists()) {
+          try {
+            JSONObject(manifest.readText()).optLong("createdAt", 0L)
+          } catch (_: Exception) {
+            0L
+          }
+        } else {
+          0L
+        }
+        val stamp = if (createdAt > 0L) createdAt else dir.lastModified()
+        if (stamp in 1 until cutoff) dir.deleteRecursively()
+      }
+    }
+  }
+}
