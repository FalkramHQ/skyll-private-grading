{
  "name": "curio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node scripts/devApiServer.js",
    "prepare": "husky",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:frontend": "npm run test && npm run build",
    "verify:intake": "npm --prefix apps/intake test && npm --prefix apps/intake run verify:release-config",
    "verify": "npm run lint && npm run test:credentials && npm run verify:frontend && npm run verify:intake",
    "test:credentials": "node scripts/testCredentialPolicy.cjs",
    "worker:ocr:check": "wrangler --config workers/mistral-ocr/wrangler.jsonc deploy --dry-run",
    "worker:ocr:deploy": "wrangler --config workers/mistral-ocr/wrangler.jsonc deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/anek-devanagari": "5.3.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@libsql/client": "^0.17.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@sentry/react": "^10.70.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.40.0",
    "html2canvas-pro": "^2.3.3",
    "html2pdf.js": "^0.14.0",
    "katex": "^0.16.45",
    "lucide-react": "^0.562.0",
    "pdfkit": "^0.20.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "smiles-drawer": "^2.4.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^7.0.2",
    "vite": "^7.3.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  }
}
