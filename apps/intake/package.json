{
  "name": "@skyll/intake",
  "private": true,
  "version": "0.1.0",
  "main": "expo/AppEntry",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --runInBand",
    "verify:release-config": "node scripts/verify-release-config.mjs",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "0.4.1",
    "@expo-google-fonts/instrument-sans": "0.4.2",
    "@expo/metro-runtime": "~57.0.7",
    "@preeternal/react-native-document-scanner-plugin": "^0.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@skyll/shared": "file:../../shared",
    "@skyll/web-lib": "file:../../src/lib",
    "expo": "~57.0.8",
    "expo-asset": "~57.0.7",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "57.0.1",
    "expo-modules-core": "~57.0.7",
    "expo-notifications": "~57.0.19",
    "expo-print": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.16",
    "expo-updates": "~57.0.10",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "patch-package": "^8.0.0"
  },
  "jest": {
    "preset": "jest-expo",
    "globals": {
      "IS_REACT_ACT_ENVIRONMENT": true
    },
    "moduleNameMapper": {
      "^../../../shared/(.*)$": "<rootDir>/../../shared/$1",
      "^@skyll/shared/(.*)$": "<rootDir>/../../shared/$1",
      "^@skyll/web-lib/(.*)$": "<rootDir>/../../src/lib/$1"
    }
  }
}
