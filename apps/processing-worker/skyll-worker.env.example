TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Default OCR engine is Datalab. Set OCR_ENGINE=mistral to force the old path.
OCR_ENGINE=datalab
DATALAB_API_KEY=
DATALAB_OCR_MODE=accurate
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
DEEPSEEK_API_KEY=
DEEPSEEK_RUBRIC_MODEL=deepseek-v4-flash
# Preferred DeepSeek-compatible path when official DeepSeek balance is down.
# When set, evidence/grading JSON calls use Phala first.
PHALA_API_KEY=
PHALA_BASE_URL=https://inference.phala.com/v1
PHALA_DEEPSEEK_MODEL=deepseek/deepseek-v4-flash-0731
# DeepInfra: JSON fallback after DeepSeek balance errors, and default VL.
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_REASONING_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# Rubric builder (DeepInfra first, then Phala/DeepSeek). Unset = DEEPINFRA_REASONING_MODEL.
# DEEPINFRA_RUBRIC_MODEL=
# Grading-only model on DeepInfra (unset = DEEPINFRA_REASONING_MODEL chain), e.g. Qwen/Qwen3.8-Flash
GRADE_MODEL=
# legacy (default) | calibrated | strict | flag
GRADE_CALIBRATION=
# Limit GRADE_CALIBRATION to these subjects (comma-separated); others stay legacy. Empty = all.
GRADE_CALIBRATION_SUBJECTS=
DEEPINFRA_VISION_MODEL=google/gemma-4-26B-A4B-it
DEEPINFRA_VISION_TIMEOUT_MS=120000
# NEAR AI private inference (TEE). Schools named here (comma list of names or ids, or *) send
# every model call carrying student data to NEAR AI only, with a verified attestation and signed
# receipt; no fallback. Answer-sheet OCR runs there too, through a vision model, for every subject.
# Rubric jobs and OCR of papers and keys hold no student data and stay on the normal providers.
# Set the same school list on Vercel.
# Read the accuracy gaps in docs/OCI_WORKER.md and eval-gate before adding a school.
NEAR_AI_API_KEY=
NEAR_AI_SCHOOLS=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
NEAR_AI_OCR_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
NEAR_AI_OCR_FALLBACK_MODEL=Qwen/Qwen3.8-27B
NEAR_AI_VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# 1 turns on DeepSeek thinking mode (off by default, matching production grading).
NEAR_AI_THINKING=0
NEAR_AI_ATTESTATION_TTL_MS=3600000
NEAR_AI_TCB_STATUSES=UpToDate,OutOfDate
# Fallback VL only if Gemma is unavailable. Tables remain on the Mistral OCR path.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
DASHSCOPE_VISION_MODEL=qwen3.7-flash
DASHSCOPE_VISION_TIMEOUT_MS=120000
QWEN_REASONING_MODEL=qwen3.7-plus
QWEN_TIMEOUT_MS=90000
REPORT_MODULE_PROVIDER=qwen
# Optional fallback when the primary DashScope Qwen request is unavailable.
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
GLM_VISION_MODEL=glm-4.5v
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Supplementary PaddleOCR (PP-OCRv6 + PaddleOCR-VL-1.6) — optional.
# When set, answer sheets are processed by Paddle in addition to Datalab.
# Runs are stored as is_active=0 (supplementary) for cross-validation.
POLL_INTERVAL_MS=3000
# Leases are extended by a timer while a job runs, so they only need to outlast
# a few missed beats. Keep LEASE >= 3x HEARTBEAT.
PROCESSING_JOB_LEASE_MS=300000
PROCESSING_JOB_HEARTBEAT_MS=30000
# On SIGTERM, an in-flight job gets this long to finish before it is released
# back to the queue. Keep below the unit's TimeoutStopSec (45s).
WORKER_SHUTDOWN_GRACE_MS=30000
PROCESSING_JOB_MAX_ATTEMPTS=3
# Optional comma-separated local/operational lane restriction, e.g.
# PROCESSING_JOB_TYPES=visual_rescue. Leave blank for normal full processing.
PROCESSING_JOB_TYPES=
PROCESSING_JOB_RETRY_BASE_MS=60000
PROCESSING_JOB_RETRY_MAX_MS=900000
WORKER_HEARTBEAT_MS=30000
# Set at deploy time to the immutable git revision.
SKYLL_WORKER_VERSION=unknown

# Hive DNA synthesis: JSON budget and re-queue cooldown after a failed run
# HIVE_SYNTHESIS_MAX_TOKENS=6000
# HIVE_SYNTHESIS_FAILURE_COOLDOWN_MS=86400000

# Operational alerts (Slack/Discord-compatible JSON webhook). Unset = disabled.
# ALERT_WEBHOOK_URL=
# A Lark/Feishu custom-bot URL gets Lark's message format; set the bot's
# signing secret here when signature verification is on. Set both in Vercel too
# so API-side cohort regrades can raise score_mismatch alerts.
# ALERT_WEBHOOK_SECRET=
# ALERT_WINDOW_MS=900000
# Housekeeping: prune stopped worker heartbeats and long-expired sessions.
# HOUSEKEEPING_INTERVAL_MS=21600000
# HOUSEKEEPING_HEARTBEAT_RETENTION_MS=604800000
# HOUSEKEEPING_SESSION_RETENTION_MS=2592000000
