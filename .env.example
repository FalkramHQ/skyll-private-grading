# Skyll Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is gitignored.

# ─── Database (Turso / libSQL) ───────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ─── Object Storage (Cloudflare R2 / S3-compatible) ─────────────────────────
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_BUCKET=skyll
S3_REGION=auto
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# ─── OCR (Mistral) ───────────────────────────────────────────────────────────
MISTRAL_API_KEY=your-mistral-api-key
# MISTRAL_OCR_MODEL=mistral-ocr-latest

# ─── AI Grading (DeepSeek / Phala / DeepInfra) ───────────────────────────────
# At least one of PHALA_API_KEY, DEEPSEEK_API_KEY, or DEEPINFRA_API_KEY is required.
DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
# DEEPSEEK_EXAM_MODEL=deepseek-v4-flash
# DEEPSEEK_RUBRIC_MODEL=deepseek-v4-flash
# DEEPSEEK_REVIEW_MODEL=deepseek-chat
# PHALA_API_KEY=
# PHALA_BASE_URL=https://inference.phala.com/v1
# PHALA_DEEPSEEK_MODEL=deepseek/deepseek-v4-flash-0731
# DeepInfra: JSON fallback when DeepSeek balance is down, and default VL (Gemma).
# DEEPINFRA_API_KEY=
# DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
# DEEPINFRA_REASONING_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# DEEPINFRA_VISION_MODEL=google/gemma-4-26B-A4B-it
# DEEPINFRA_VISION_TIMEOUT_MS=120000

# ─── Natural Language Query (OpenRouter) ────────────────────────────────────
# OPENROUTER_API_KEY=
# OPENROUTER_SITE_URL=https://www.skyllai.com
# OPENROUTER_TITLE=Skyll AI
# NLQ_MODEL=openrouter/free

# ─── Worker Configuration (OCI) ──────────────────────────────────────────────
# Set to empty string to process all schools, or a school name to scope.
PROCESSING_SCHOOL=
# PROCESSING_TEST_ID=
# PROCESSING_JOB_TYPES=
# POLL_INTERVAL_MS=3000
# PROCESSING_JOB_LEASE_MS=300000
# PROCESSING_JOB_HEARTBEAT_MS=30000
# WORKER_SHUTDOWN_GRACE_MS=30000
# PROCESSING_JOB_MAX_ATTEMPTS=3
# PROCESSING_JOB_RETRY_BASE_MS=60000
# PROCESSING_JOB_RETRY_MAX_MS=900000
# WORKER_HEARTBEAT_MS=30000
# COHORT_REGRADE_LEASE_MS=600000
# HIVE_SYNTHESIS_QUEUE_MS=900000
# SKYLL_WORKER_VERSION=local

# ─── Intake App ──────────────────────────────────────────────────────────────
# EXPO_PUBLIC_API_ORIGIN=https://www.skyllai.com

# ─── Optional: Paddle OCR ───────────────────────────────────────────────────
# PADDLE_OCR_TOKEN=

# ─── Datalab OCR (default worker engine) ────────────────────────────────────
# OCR_ENGINE=datalab
# DATALAB_API_KEY=
# DATALAB_OCR_MODE=accurate
# Set OCR_ENGINE=mistral to use Mistral OCR instead.

# ─── Optional: Qwen / DashScope (VL models for review only, never OCR) ──────
# QWEN_API_KEY=
# QWEN_BASE_URL=
# QWEN_REASONING_MODEL=
# QWEN_RUBRIC_MODEL=
# QWEN_TIMEOUT_MS=
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=
# DASHSCOPE_VISION_MODEL=
# DASHSCOPE_VISION_TIMEOUT_MS=

# ─── Optional: GLM (VL models for review only) ───────────────────────────────
# GLM_API_KEY=
# GLM_BASE_URL=
# GLM_VISION_MODEL=

# ─── Optional: MI / MIMO ─────────────────────────────────────────────────────
# MI_API_KEY=
# MI_BASE_URL=
# MI_MODEL=
# MIMO_API_KEY=

# ─── Optional: Report Module ─────────────────────────────────────────────────
# REPORT_MODULE_PROVIDER=
# REGEN_CONCURRENCY=
# REASONING_JSON_ATTEMPTS=

# ─── Optional: Grading Tuning ───────────────────────────────────────────────
# GRADING_BATCH_SIZE=
# GRADING_AUDIT_BATCH_SIZE=
# GRADING_EXPECTED_TOTAL=
# GRADING_SAMPLES=
# GRADING_SEED=
# MASTERY_ESTIMATION_ENABLED=

# ─── Optional: Misc ──────────────────────────────────────────────────────────
# SKYLL_RELEASE_ORIGIN=https://www.skyllai.com
# OCR_WORKER_URL=
# OCR_WORKER_SHARED_SECRET=
# PDFTOPPM=

# ─── Optional: Error Monitoring (Sentry) ─────────────────────────────────────
# Get a DSN at https://sentry.io → Settings → Projects → Client Keys
# VITE_SENTRY_DSN=

# ─── Optional: Marketing tracking on public pages (src/lib/siteTracking.js) ──
# GA4: Admin → Data streams → Web → Measurement ID (G-XXXXXXX)
# VITE_GA_MEASUREMENT_ID=
# Meta: Events Manager → Data sources → Pixel ID (digits)
# VITE_META_PIXEL_ID=

# ─── Optional: WhatsApp from each class's own number (CRM M2 phase 2) ───────
# Falkram's Meta app (Tech Provider). Classes connect their number in
# CRM → Settings → WhatsApp. See docs/CRM_M2_COMMS_IMPLEMENTATION.md.
# WHATSAPP_TOKEN_KEY=                # 32 random bytes, base64; encrypts class tokens (Vercel + worker)
# META_APP_ID=
# META_APP_SECRET=                   # verifies webhooks and exchanges signup codes
# META_ES_CONFIG_ID=                 # Embedded Signup configuration id
# META_WEBHOOK_VERIFY_TOKEN=
# META_GRAPH_VERSION=v23.0
# META_SOLUTION_ID=                  # optional: a Solution Partner's multi-partner solution (billing)
# PUBLIC_APP_URL=https://www.skyllai.com  # base of fees and report links in messages
